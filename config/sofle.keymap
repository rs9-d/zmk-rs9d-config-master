#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        paste: paste {
            compatible = "zmk,behavior-tap-dance";
            label = "PASTE";
            #binding-cells = <0>;
            bindings = <&mt LC(V) V>, <&kp LC(LA(LS(V)))>;
        };

        lyr_pick: lyr_pick {
            compatible = "zmk,behavior-tap-dance";
            label = "LYR_PICK";
            #binding-cells = <0>;
            bindings = <&tog 1>, <&mo 2>, <&mo 3>;
        };

        tildesc: tildesc {
            compatible = "zmk,behavior-mod-morph";
            label = "TILDESC";
            bindings = <&kp ESCAPE>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&tildesc    &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                           &kp N6  &kp N7     &kp N8     &kp N9    &kp N0         &kp DELETE
&kp TAB     &kp Q   &kp W     &kp E     &kp R      &kp T                            &kp Y   &kp U      &kp I      &kp O     &kp P          &kp BSPC
&kp CAPS    &kp A   &kp S     &kp D     &kp F      &kp G                            &kp H   &kp J      &kp K      &kp L     &kp SEMICOLON  &kp SQT
&kp LSHIFT  &kp Z   &kp X     &kp C     &kp V      &kp B      &tog 4     &none      &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH       &kp RSHFT
                    &kp LGUI  &kp LALT  &kp LCTRL  &lyr_pick  &kp RET    &kp SPACE  &none   &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp LC(Z) LC(LS(Z))>,
                <&inc_dec_kp K_SCROLL_DOWN K_SCROLL_UP>;
        };

        design {
            bindings = <
&trans                                       &kp KP_N1            &kp KP_N2         &kp KP_N3     &kp KP_N4  &kp KP_N5                           &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_N0  &trans
&kp ESCAPE                                   &mt LS(LC(G)) LC(G)  &kp I             &mt LC(S) W   &mt P T    &kp BACKSPACE                       &trans     &trans     &trans     &trans     &trans     &trans
&mt LC(LS(RIGHT_BRACKET)) LC(RIGHT_BRACKET)  &kp LEFT_SHIFT       &kp LEFT_CONTROL  &kp LEFT_ALT  &kp SPACE  &mt LC(A) A                         &trans     &trans     &trans     &trans     &trans     &trans
&mt LS(LC(LEFT_BRACKET)) LC(LEFT_BRACKET)    &kp Z                &mt LC(X) X       &mt LC(C) C   &paste     &trans         &trans       &trans  &trans     &trans     &trans     &trans     &trans     &trans
                                                                  &trans            &trans        &mo 3      &to 0          &kp ENTER    &trans  &trans     &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(Z) LC(LS(Z))>;
            label = "design";
        };

        symbols {
            bindings = <
&trans     &kp F1     &kp F2     &kp F3     &kp F4          &kp F5                             &kp F6     &kp F7    &kp F8     &kp F9                &kp F10                &trans
&kp GRAVE  &kp N1     &kp N2     &kp N3     &kp N4          &kp N5                             &kp N6     &kp N7    &kp N8     &kp N9                &kp N0                 &trans
&kp TAB    &kp EXCL   &kp AT     &kp POUND  &kp DOLLAR      &kp PERCENT                        &kp CARET  &kp AMPS  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&kp LSHFT  &kp EQUAL  &kp MINUS  &kp PLUS   &kp LEFT_BRACE  &kp RIGHT_BRACE  &none     &none   &kp LBKT   &kp RBKT  &kp SEMI   &kp COLON             &kp BSLH               &none
                      &trans     &trans     &trans          &trans           &trans    &trans  &trans     &trans    &trans     &trans
            >;

            label = "symbols";
        };

        navigation {
            bindings = <
&none      &none       &none      &none      &none      &none                   &none  &none  &none  &none  &none  &none
&none      &none       &none      &kp UP     &none      &none                   &none  &none  &none  &none  &none  &none
&kp LCTRL  &kp LSHIFT  &kp LEFT   &kp DOWN   &kp RIGHT  &none                   &none  &none  &none  &none  &none  &none
&none      &none       &kp LC(X)  &kp LC(C)  &kp LC(V)  &none   &none    &none  &none  &none  &none  &none  &none  &none
                       &none      &none      &none      &trans  &none    &none  &none  &none  &none  &none
            >;

            label = "navigation";
        };

        gaming {
            bindings = <
&tildesc   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                          &kp NUMBER_6  &kp N7  &kp N8     &kp N9   &kp N0    &trans
&kp TAB    &kp Q         &kp W         &kp E         &kp R         &kp T                           &kp Y         &kp U   &kp I      &kp O    &kp P     &trans
&kp CAPS   &kp A         &kp S         &kp D         &kp F         &kp G                           &kp H         &kp J   &kp K      &kp L    &kp SEMI  &trans
&kp LSHFT  &kp Z         &kp X         &kp C         &kp V         &kp B         &trans    &trans  &kp N         &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
                         &kp LEFT_WIN  &kp LCTRL     &kp SPACE     &kp LEFT_ALT  &trans    &trans  &none         &trans  &trans     &trans
            >;

            label = "gaming";
        };
    };
};
